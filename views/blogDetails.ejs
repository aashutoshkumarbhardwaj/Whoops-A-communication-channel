<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= blog.title %></title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <div class="text-muted mb-3">
            By <%= blog.author?.name || 'Unknown Author' %> &middot; <%= new Date(blog.createdAt).toLocaleDateString() %>
        </div>
        
        <% if (blog.coverImage) { %>
            <img src="<%= blog.coverImage %>" class="img-fluid rounded mb-4" style="width: 100%; max-height: 500px; object-fit: cover;" alt="Cover Image for <%= blog.title %>">
        <% } %>
        
        <div class="blog-content fs-5">
            <%- blog.content.replace(/\n/g, '<br>') %>
        </div>

        <hr class="my-4">

        <!-- Comments Section -->
        <div class="comments-section mt-4">
            <h3>Comments (<%= locals.comments ? comments.length : 0 %>)</h3>

            <% if (user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="POST" class="mb-4">
                    <div class="mb-3">
                        <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
            <% } else { %>
                <p class="text-muted"><a href="/user/signin">Sign in</a> to post a comment.</p>
            <% } %>

            <div class="comment-list mt-4">
                <% if (locals.comments && comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="card-subtitle text-muted">
                                        <strong><%= comment.author?.name || 'Anonymous' %></strong>
                                    </h6>
                                    <small class="text-muted"><%= new Date(comment.createdAt).toLocaleString() %></small>
                                </div>
                                <p class="card-text mt-2 mb-0"><%= comment.content %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No comments yet. Be the first to comment!</p>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>