<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <%- include('partials/nav') %>

    <!-- For debugging: <%= JSON.stringify(user) %> -->
    <div class="container">
        <% if (flash.length) { %>
            <ul class="flash">
                <% flash.forEach(function(msg){ %>
                    <li><%= msg %></li>
                <% }) %>
            </ul>
        <% } %>

        <div class="row row-cols-1 row-cols-md-3 g-4 mt-3">
            <% if (locals.blogs) { blogs.forEach(blog => { %>
            <div class="col">
                <div class="card h-100">
                    <img src="<%= blog.coverImage %>" class="card-img-top" alt="Cover Image" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title"><%= blog.title %></h5>
                        <p class="card-text"><%= blog.content.substring(0, 100) %>...</p>
                        <a href="/blog/<%= blog._id %>" class="btn btn-primary">Read More</a>
                    </div>
                    <div class="card-footer">
                        <small class="text-body-secondary">By <%= blog.author ? blog.author.name : "Unknown" %></small>
                    </div>
                </div>
            </div>
            <% }) } %>
        </div>
    </div>

    <script src="/scripts.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>